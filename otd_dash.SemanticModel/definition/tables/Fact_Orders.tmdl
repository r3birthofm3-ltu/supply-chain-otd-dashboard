	partition Fact_Orders = m
		mode: import
		source =
				let
				    DataPath = "D:\Projects_o26\PoweBI_dash\data\raw\DataCoSupplyChainDataset.csv",
				    Source = Csv.Document(File.Contents(DataPath),
				        [Delimiter=",", Encoding=1252, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {
				        {"order date (DateOrders)", type datetime},
				        {"shipping date (DateOrders)", type datetime},
				        {"Days for shipping (real)", Int64.Type},
				        {"Days for shipment (scheduled)", Int64.Type},
				        {"Sales", type number},
				        {"Order Profit Per Order", type number}
				    }, "en-US"),
				    Dropped = Table.RemoveColumns(Typed, {"Customer Email", "Customer Password",
				        "Customer Street", "Product Description", "Product Image"}, MissingField.Ignore),
				    OrderDate = Table.AddColumn(Dropped, "Order Date", each DateTime.Date([#"order date (DateOrders)"]), type date),
				    Delay = Table.AddColumn(OrderDate, "Delay Days",
				        each [#"Days for shipping (real)"] - [#"Days for shipment (scheduled)"], Int64.Type),
				    OTD = Table.AddColumn(Delay, "OTD Flag", each if [Delay Days] <= 0 then 1 else 0, Int64.Type),
				    Canceled = Table.AddColumn(OTD, "Is Canceled", each [Delivery Status] = "Shipping canceled", type logical),
				  #"Choose columns" = Table.SelectColumns(Canceled, {"Type", "Days for shipping (real)", "Days for shipment (scheduled)", "Benefit per order", "Sales per customer", "Delivery Status", "Late_delivery_risk", "Category Id", "Category Name", "Customer City", "Customer Country", "Customer Fname", "Customer Id", "Customer Lname", "Customer Segment", "Customer State", "Customer Zipcode", "Department Id", "Department Name", "Latitude", "Longitude", "Market", "Order City", "Order Country", "Order Customer Id", "order date (DateOrders)", "Order Id", "Order Item Cardprod Id", "Order Item Discount", "Order Item Discount Rate", "Order Item Id", "Order Item Product Price", "Order Item Profit Ratio", "Order Item Quantity", "Sales", "Order Item Total", "Order Profit Per Order", "Order Region", "Order State", "Order Status", "Order Zipcode", "Product Card Id", "Product Category Id", "Product Name", "Product Price", "Product Status", "shipping date (DateOrders)", "Shipping Mode", "Order Date", "Delay Days", "OTD Flag", "Is Canceled"}),
				  #"Changed column type" = Table.TransformColumnTypes(#"Choose columns", {{"Delivery Status", type text}, {"Late_delivery_risk", Int64.Type}}, "en-US")
				in
				    #"Changed column type"

	annotation PBI_ResultType = Table

