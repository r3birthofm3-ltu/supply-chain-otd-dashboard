	partition Dim_Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (
				        DATE ( YEAR ( MIN ( Fact_Orders[Order Date] ) ), 1, 1 ),
				        DATE ( YEAR ( MAX ( Fact_Orders[Order Date] ) ), 12, 31 )
				    ),
				    "Year", YEAR ( [Date] ),
				    "Quarter", "Q" & QUARTER( [Date] ),
				    "Month No", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMM" ),
				    "Year-Month", FORMAT ( [Date], "YYYY-MM" )
				)

	annotation PBI_Id = b3f86a5767d9435ba215ffeeb58647f5

